<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Messenger.Client.Views.ChatListView">
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <!-- Header -->
    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="16">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="Messenger" FontSize="24" FontWeight="SemiBold" 
                   Foreground="#212121" VerticalAlignment="Center" />
        <CheckBox Grid.Column="1" Content="Уведомления" IsChecked="{Binding NotificationsEnabled}" 
                  Command="{Binding ToggleNotificationsCommand}" Margin="0,0,12,0" />
        <Button Grid.Column="2" Content="Профиль" Command="{Binding OpenProfileCommand}" 
                Background="Transparent" Foreground="#0088CC" 
                BorderBrush="#E5E5E5" BorderThickness="1" Padding="12,6" />
      </Grid>
    </Border>

    <!-- Search -->
    <Border Grid.Row="1" Background="#F8F8F8" Padding="12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0" Text="{Binding Search}" Watermark="Введите имя пользователя для начала чата..." 
                 Background="White" BorderBrush="#E5E5E5" Padding="12,8" />
        <Button Grid.Column="1" Content="Начать чат" Command="{Binding StartChatCommand}" 
                Margin="8,0,0,0" Width="120" Background="#0088CC" Foreground="White" />
      </Grid>
    </Border>

    <!-- Error -->
    <Border Grid.Row="2" Background="#FFF0F0" BorderBrush="#FF4444" BorderThickness="0,0,0,1" Padding="12"
            IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding Error}" Foreground="#FF4444" FontSize="14" />
    </Border>

    <!-- Dialogs List -->
    <ListBox Grid.Row="3" x:Name="DialogsList" ItemsSource="{Binding Dialogs}" 
             SelectionMode="Single" Background="White">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Padding="12,10" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" 
                  Background="White" Cursor="Hand" Loaded="OnDialogItemLoaded" 
                  PointerPressed="OnDialogItemPointerPressed">
            <Border.Styles>
              <Style Selector="Border:pointerover">
                <Setter Property="Background" Value="#F5F5F5" />
              </Style>
            </Border.Styles>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <!-- Avatar -->
              <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28" 
                      Background="#0088CC" Margin="0,0,12,0">
                <Panel>
                  <Image x:Name="AvatarImage" Stretch="UniformToFill" />
                  <TextBlock x:Name="AvatarText" Text="?" 
                             FontSize="20" FontWeight="SemiBold" Foreground="White" 
                             VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Panel>
              </Border>
              
              <!-- Name and Message -->
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="UsernameText" Grid.Column="0" Text="User" 
                             FontSize="16" FontWeight="SemiBold" Foreground="#212121" />
                  <TextBlock Grid.Column="1" Text="{Binding LastMessageAt, StringFormat='HH:mm'}" 
                             FontSize="13" Foreground="#999999" Margin="8,0,0,0" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                  <TextBlock Grid.Column="0" Text="{Binding LastMessagePreview}" 
                             FontSize="14" Foreground="#707579" TextTrimming="CharacterEllipsis" />
                </Grid>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
